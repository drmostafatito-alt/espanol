    "scenarios": [
      {
        "contextAr": "عميل غاضب يرفع صوته. أنت الموظف أندريس. (أسماء وأرقام وهمية للتدريب فقط)",
        "settingAr": "مركز اتصال، عميل غاضب (بيانات وهمية)",
        "lines": [
          {
            "es": "Le escucho con calma. Entiendo su frustración después de tanta espera.",
            "ar": "أستمع إليك بهدوء. أتفهّم إحباطك بعد كل هذا الانتظار.",
            "arEg": "سامعك بهدوء. فاهم إحباطك بعد الانتظار ده كله.",
            "audioKey": "pending/cc-u4-calming-line-1"
          },
          {
            "es": "¡Ya basta! ¡Quiero una solución ahora!",
            "ar": "كفى! أريد حلًا الآن!",
            "arEg": "كفاية! عاوز حل دلوقتي!",
            "audioKey": "pending/cc-u4-calming-line-2"
          },
          {
            "es": "Tiene razón. Voy a ayudarle ahora mismo, paso a paso, sin más esperas.",
            "ar": "معك حق. سأساعدك الآن، خطوة بخطوة، دون مزيد من الانتظار.",
            "arEg": "عندك حق. هساعدك دلوقتي، خطوة خطوة، من غير انتظار تاني.",
            "audioKey": "pending/cc-u4-calming-line-3"
          },
          {
            "es": "Bien. Empiece, por favor, que no tengo todo el día.",
            "ar": "حسنًا. ابدأ من فضلك، فليس لدي اليوم كله.",
            "arEg": "طيب. ابدأ من فضلك، معنديش اليوم كله.",
            "audioKey": "pending/cc-u4-calming-line-4"
          }
        ]
      }
    ],
    "culturalNoteAr": "الهدوء مُعدٍ كما الغضب مُعدٍ: خفض السرعة والنبرة من الموظف يخفض حدة العميل دون كلمة «اهدأ» واحدة.",
    "pedagogicalRationaleAr": "التهدئة إجراء لا شعار: اعتراف بالشعور + خطوة فورية محددة، لا وعود عامة بالهدوء.",
