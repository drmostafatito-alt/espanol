{
  "name": "espanol-balarabi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker:dev": "node tools/wrangler-env/node_modules/wrangler/wrangler-dist/cli.js dev --local --port 8787 --ip 0.0.0.0",
    "db:migrate:local": "node tools/db.mjs migrate",
    "db:seed:local": "node tools/db.mjs seed",
    "test": "vitest run",
    "db:reset:local": "node tools/db.mjs reset",
    "validate": "node tools/check-sql.mjs && node tools/validate-content.mjs && node tools/check-audio-manifest.mjs",
    "validate:audio": "node tools/check-audio-manifest.mjs",
    "db:status": "node tools/db.mjs status",
    "db:audit": "node tools/audit-db-integrity.mjs",
    "db:test-safety": "node tools/test-import-safety-isolated.mjs",
    "bench:kdf": "node tools/bench-kdf.mjs",
    "audit:security": "node tools/security-audit.mjs",
    "deploy:preflight": "node tools/check-deploy-ready.mjs",
    "test:e2e": "playwright test",
    "test:browser": "node tools/run-browser-tests.mjs",
    "test:live": "node tools/test-learner-flow-live.mjs",
    "test:ui": "vitest run tests/ui-lesson.test.tsx",
    "test:journey": "node tools/journey-live-19.mjs",
    "test:audio": "node tools/test-static-audio-browser.mjs",
    "audio:generate": "node tools/generate-sample-audio.mjs",
    "content:import": "node tools/import-content.mjs",
    "content:import:all": "node tools/import-content.mjs --all",
    "content:plan": "node tools/import-content.mjs --dry-run"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^11.5.0",
    "hash-wasm": "^4.12.0",
    "jsdom": "25.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
