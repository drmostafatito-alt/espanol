{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vocabulary.schema.json",
  "title": "حزمة مفردات — Español بالعربي",
  "type": "object",
  "required": [
    "schemaVersion",
    "bundleSlug",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleSlug": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "license",
        "accessedAt"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 3
        },
        "accessedAt": {
          "type": "string"
        },
        "rankingNote": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "headword",
          "normalized",
          "kind",
          "pos",
          "level",
          "senses",
          "examples"
        ],
        "properties": {
          "headword": {
            "$ref": "common.schema.json#/$defs/textEs"
          },
          "normalized": {
            "type": "string",
            "pattern": "^[a-záéíóúüñ0-9 ]{2,60}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "word",
              "expression",
              "collocation",
              "idiom"
            ]
          },
          "pos": {
            "type": "string",
            "enum": [
              "noun",
              "verb",
              "adj",
              "adv",
              "pron",
              "prep",
              "conj",
              "det",
              "interj",
              "num",
              "phrase"
            ]
          },
          "gender": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "m",
              "f",
              "mf",
              null
            ]
          },
          "plural": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "$ref": "common.schema.json#/$defs/level"
          },
          "register": {
            "$ref": "common.schema.json#/$defs/register"
          },
          "ipa": {
            "type": [
              "string",
              "null"
            ]
          },
          "pronunciationHintAr": {
            "type": [
              "string",
              "null"
            ]
          },
          "internalRank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "senses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "senseNo",
                "meaningArFusha",
                "exampleEs",
                "exampleAr"
              ],
              "properties": {
                "senseNo": {
                  "type": "integer",
                  "minimum": 1
                },
                "meaningArFusha": {
                  "type": "string",
                  "minLength": 2
                },
                "meaningArEg": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "glossEs": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "exampleEs": {
                  "$ref": "common.schema.json#/$defs/textEs"
                },
                "exampleAr": {
                  "$ref": "common.schema.json#/$defs/textAr"
                },
                "exampleArEg": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usageNoteAr": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "commonErrorAr": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "audioKey": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "forms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "formEs"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "conjugation",
                    "plural",
                    "feminine",
                    "participle",
                    "gerund",
                    "diminutive"
                  ]
                },
                "formEs": {
                  "type": "string",
                  "minLength": 2
                },
                "tense": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mood": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "person": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "irregular": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "es",
                "ar"
              ],
              "properties": {
                "es": {
                  "$ref": "common.schema.json#/$defs/textEs"
                },
                "ar": {
                  "$ref": "common.schema.json#/$defs/textAr"
                },
                "arEg": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "register": {
                  "$ref": "common.schema.json#/$defs/register"
                },
                "audioKey": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "antonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variantNoteAr": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "pronunciationNoteAr": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}